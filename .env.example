# Mint at https://www.assemblyai.com/dashboard — sign up through the hackathon page link so the credits attach.
ASSEMBLYAI_API_KEY=

# Optional: the brain behind real questions. With this set, /api/voice/ask answers with Claude instead of the one
# LLM Gateway model this AssemblyAI account can reach (a 4B Qwen, 2 requests per ~35 s). ASK_CLAUDE_MODEL defaults
# to claude-opus-5 at low effort; measure the answer latency before choosing a smaller, faster model.
# ANTHROPIC_API_KEY=
# ASK_CLAUDE_MODEL=claude-opus-5
