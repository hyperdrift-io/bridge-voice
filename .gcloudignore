# `gcloud run deploy --source .` falls back to .gitignore without this file, and .gitignore hides public/index.html
# (the snapshot stays out of git until the founder approves the scrub). The upload needs it; it never needs the key.
.git
.gitignore
.env
.env.*
node_modules/
dist/
src/
docs/
pnpm-lock.yaml
pnpm-workspace.yaml
*.log
.DS_Store
# API-only deploys never carry the snapshot: it goes public only after the founder approves the scrub.
public/index.html
# a day being prepared stays on this machine
snapshots/
